# SkillForge Code — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.

# ─── Database ────────────────────────────────────────────────────────────────
# Postgres connection string (Supabase, local, or any managed Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skillforge

# ─── Auth ────────────────────────────────────────────────────────────────────
# REQUIRED in production. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-in-production

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8787
NODE_ENV=development

# CORS: set to your frontend's exact origin for split deployments (Vercel + separate backend)
# Leave unset for combined single-server deployment (same-origin, no CORS needed)
ALLOWED_ORIGIN=

# ─── Redis ───────────────────────────────────────────────────────────────────
# Required for BullMQ job queue and distributed rate limiting
# Local dev: redis://localhost:6379
# Managed: redis://:<password>@<host>:<port>
REDIS_URL=redis://localhost:6379

# ─── Judge ───────────────────────────────────────────────────────────────────
# 'docker' = isolated containers (production). 'host' = direct process (dev only, unsafe)
JUDGE_RUNTIME=docker
JUDGE_IMAGE=skillforge-judge:latest

# Worker pool: how many submissions judged simultaneously
JUDGE_CONCURRENCY=4

# Per-submission resource limits (override problem-level defaults)
JUDGE_MEMORY_MB=256
JUDGE_CPU_LIMIT=1
JUDGE_TIMEOUT_MS=5000
JUDGE_PIDS_LIMIT=64
JUDGE_OUTPUT_LIMIT_KB=1024
JUDGE_MAX_SOURCE_KB=256
JUDGE_COMPILE_TIMEOUT_MS=15000

# ─── Rate Limiting ───────────────────────────────────────────────────────────
# Minimum milliseconds between a student's submissions
SUBMIT_MIN_GAP_MS=3000
# Max in-flight (Queued/Running) submissions per student
SUBMIT_MAX_PENDING=1
# General API rate limit (requests per minute per IP)
API_RATE_LIMIT=300
# Auth endpoints rate limit (requests per minute per IP)
AUTH_RATE_LIMIT=20

# ─── Contest ─────────────────────────────────────────────────────────────────
# Grace period (ms) past contest end time for last-second submissions
CONTEST_END_GRACE_MS=5000

# ─── Email (password reset) ──────────────────────────────────────────────────
# Leave unset to fall back to console.log (fine for local dev)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-api-key
# SMTP_FROM=SkillForge Code <no-reply@yourdomain.com>
# SMTP_SECURE=false

# ─── Frontend (build-time only) ──────────────────────────────────────────────
# Only needed for split Vercel frontend + separate backend deployment
# Set when running: npm run build
# VITE_API_URL=https://your-backend.onrender.com
